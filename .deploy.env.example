# 部署目标配置示例。复制为 .deploy.env 后填写真实值；.deploy.env 不入库。
#
#   cp .deploy.env.example .deploy.env
#
# 这些值也会被同名环境变量覆盖。

# SSH 目标，可写成别名（~/.ssh/config）或 user@host
DEPLOY_HOST=user@your-server

# 静态文件发布目录（服务器上由 Nginx 的 root 指向它）
DEPLOY_DIR=/var/www/musica

# 站点地址，填了才会在部署后自检首页/深链/节拍器
# DEPLOY_URL=https://musica.example.com

# 子路径部署时填写，例如 /musica/（根目录部署留空）
# DEPLOY_BASE=/

# 仅 --remote 模式需要：在服务器上执行构建的用户，以及源码目录
# DEPLOY_REMOTE_USER=deploy
# DEPLOY_REMOTE_SRC=/opt/musica
